# Copy to .env. For LOCAL DEVELOPMENT only.
MYSQL_PORT=3307
MYSQL_DATABASE=wspm_combo
MYSQL_USER=wspm_app
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456

# Auth: one Base64-encoded random secret (at least 32 decoded bytes), no PEM files.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave no default secret in Git. Empty/invalid/short secrets fail startup.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_KEY_ID=wspm-local-1
# Local HTTP development only. HTTPS deployments must set true and HTTPS origins.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# WDM export/upload limits. Byte limits include the complete CSV artifact.
WDM_ORDER_EXPORT_MAX_ROWS=100000
WDM_ORDER_EXPORT_MAX_BYTES=104857600
WDM_CSV_UPLOAD_MAX_FILE_BYTES=104857600
WDM_CSV_UPLOAD_MAX_REQUEST_BYTES=105906176
# Optional absolute, private directory OUTSIDE this repository. Default: user-home/.wspm/snapshots.
# WDM_SNAPSHOT_STORAGE_ROOT=E:/wspm-data/snapshots

# Managed mining is opt-in. Outcomes remain bounded/in-memory until publication.
# Native Combo policy uses the exact owner-approved seeder category IDs in application.yaml.
# Override both comma-separated ID lists only when deploying a different reviewed catalog.
# TV2_COMBO_LAPTOP_CATEGORY_IDS=e94fd8e6-4e01-54d7-9872-73b19997722f
# TV2_COMBO_ACCESSORY_CATEGORY_IDS=8b877527-9862-571f-bf47-61cb515da304,56f90ed8-3291-5285-9e08-91b94aa88ecc,9a453e78-cdaa-50b9-adf3-d6293ce7d1b4,5bd6a957-c0d1-5c73-a237-4fe41d161727
# Optional private stable signing key (at least 32 bytes); otherwise domain-separated AUTH_JWT_SECRET is used.
# TV2_COMBO_CONTEXT_KEY=<operator-managed-secret-outside-Git>
WDM_EXECUTION_ENABLED=true
# WDM-06.11: atomically publish complete results, then acknowledge retained Outcomes.
# Requires managed execution; published reads also work with execution disabled.
WDM_RESULT_PUBLICATION_ENABLED=true
WDM_EXECUTION_PARALLELISM=2
WDM_EXECUTION_QUEUE_CAPACITY=50
WDM_EXECUTION_SHUTDOWN_GRACE_MILLIS=30000
WDM_EXECUTION_LEASE_MILLIS=60000
WDM_EXECUTION_HEARTBEAT_MILLIS=10000
WDM_EXECUTION_RECOVERY_BATCH=100

# Product images, relative to repository root; use an absolute path when launching elsewhere.
PRODUCT_IMAGES_ROOT=./backend/uploads/products
